{
  "expo": {
    "name": "Edusync",
    "slug": "edusync-api",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoImg.png",
    "scheme": "edusync",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.edusynctcc.edusync",
      "supportsTablet": true
    },
    "android": {
      "package": "com.edusynctcc.edusync",
      "adaptiveIcon": {
        "backgroundColor": "#0B1E3D",
        "foregroundImage": "./assets/images/logoImg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/logoImg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoImg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1E3D"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4315f354-7c97-4213-a673-ad453c12563e"
      }
    },
    "owner": "edusynctcc"
  }
}
